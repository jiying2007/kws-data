      "status": "success",
      "target_conditioned": false,
      "training_allowed": false
    },
    {
      "id": "b17-natural-1221-135766-0014",
      "input_coverage_complete": true,
      "provider": "whisper",
      "raw_transcript": " Pearl saw and gazed intently, but never sought to make acquaintance.",
      "source_pcm_sha256": "ecbe95c221eee281f939c36d5fe35ac8ec6668caee4c1cf10740b57eb17fae08",
      "source_samples": 76000,
      "source_wav_sha256": "1c914eb0f4d89f8614873dd1007e30f32100d2f29078c90a9c018501f2166ec2",
      "status": "success",
      "target_conditioned": false,
      "training_allowed": false
    },
    {
      "id": "b17-natural-8224-274381-0011",
      "input_coverage_complete": true,
      "provider": "whisper",
      "raw_transcript": " His conduct and presence of mind in this emergence appeared conspicuous.",
      "source_pcm_sha256": "4e1a55f5088960e222bf0b00a31a35755ce7782480b213f7e15616aadd9b78e2",
