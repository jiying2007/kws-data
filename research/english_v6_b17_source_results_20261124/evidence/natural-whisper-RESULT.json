    },
    {
      "id": "b17-natural-8555-292519-0013",
      "input_coverage_complete": true,
      "provider": "whisper",
      "raw_transcript": " That was but rustling of tripping plants in the dark.",
      "source_pcm_sha256": "68efad114bb2299fe2c838feb49f821c8dab11d28726e4ce16f093abe2416dc9",
      "source_samples": 66960,
