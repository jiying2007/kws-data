    },
    {
      "id": "b17-natural-7176-92135-0024",
      "input_coverage_complete": true,
      "provider": "whisper",
      "raw_transcript": " to be or not to be? That is the question. Whether to his no blur-",
      "source_pcm_sha256": "74ee1f3243145f53650cf76237ee516219f417573f9c60a04a9ce0f21a3fc779",
      "source_samples": 65600,
