      "status": "success",
      "target_conditioned": false,
      "training_allowed": false
    },
    {
      "id": "b17-natural-1221-135766-0013",
      "input_coverage_complete": true,
      "provider": "whisper",
      "raw_transcript": " Pearl was a born outcast of the infantile world.",
      "source_pcm_sha256": "f809b8da96a47b01778c7dec87a29bb411c7d8b9ec7f47382600ec90a03462a0",
      "source_samples": 58320,
