    },
    {
      "id": "b17-natural-8224-274384-0003",
      "input_coverage_complete": true,
      "provider": "whisper",
      "raw_transcript": " Or hath he given us any gift?",
      "source_pcm_sha256": "e598581b8ae901404a737714f666302ce7251344bc5349a5f2ab3da3369f2311",
