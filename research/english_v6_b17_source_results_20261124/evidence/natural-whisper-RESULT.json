    },
    {
      "id": "b17-natural-8555-284447-0022",
      "input_coverage_complete": true,
      "provider": "whisper",
      "raw_transcript": " I had a notion it was you made to save me from the knife.",
      "source_pcm_sha256": "108cf00c8052ccb9359d87e3fbc112d0114f2b1653b5b5b60e887df49fc32c15",
      "source_samples": 56960,
      "source_wav_sha256": "87563abf677ae2d5f3c63ba3756dcbbd70254de6bcb7cce8d492cd3e2fd9d80b",
