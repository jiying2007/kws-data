    {
      "id": "b17-natural-6829-68769-0007",
      "input_coverage_complete": true,
      "provider": "whisper",
      "raw_transcript": " but under the circumstances, I doubt if such an arrangement could be made.",
      "source_pcm_sha256": "4cb14399a28e09aac637c20f3d45644172ee31ff49f3e0b018b3aeaef1357fad",
