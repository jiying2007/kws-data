    },
    {
      "id": "b17-natural-5142-33396-0035",
      "input_coverage_complete": true,
      "provider": "whisper",
      "raw_transcript": " Did you ever have such a lordly guest before? I went on.",
      "source_pcm_sha256": "6e095a168155481f888fd99499b02ebe6ce214c77468c20d154d858addccd32e",
      "source_samples": 63120,
      "source_wav_sha256": "b3d36329cf303b825750b8cc2418132c8bc11f3f6822674c96a8fbd526e4ea85",
      "status": "success",
      "target_conditioned": false,
      "training_allowed": false
    },
    {
      "id": "b17-natural-5142-33396-0037",
      "input_coverage_complete": true,
      "provider": "whisper",
      "raw_transcript": " Hawke and Nash will be your constant companion, friend farmer.",
      "source_pcm_sha256": "4a7b4750d027687bc79ac370114d954b461c8bbf75e35b4b8b841c1cf8adee65",
