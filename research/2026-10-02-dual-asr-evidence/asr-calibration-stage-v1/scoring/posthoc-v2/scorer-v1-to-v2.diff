+def possible_phonetic_edit_distance(window, target_plain):
+    """Minimum set-valued syllable edit cost; OOV is a possibility, not a reading."""
+    prior = list(range(len(target_plain) + 1))
+    for i, token in enumerate(window, 1):
+        plain = {toneless(v) for v in token['readings']}
+        cur = [i]
+        for j, readings in enumerate(target_plain, 1):
+            possible_match = token['kind'] == 'oov' or bool(plain & readings)
+            cur.append(min(cur[-1] + 1, prior[j] + 1,
+                           prior[j - 1] + (not possible_match)))
+        prior = cur
+    return prior[-1]
+
+
+def target_local_phonetic_candidates(text, tokens, target_plain):
+    """Retain bounded possible spans and boundaries; never reconstruct target text."""
+    n = len(target_plain)
+    positions = [i for i, token in enumerate(tokens) if token['kind'] != 'boundary']
+    candidates = []
+    for start in range(len(positions)):
+        for size in (n - 1, n, n + 1):
+            selected = positions[start:start + size]
+            if len(selected) != size:
+                continue
+            window = [tokens[i] for i in selected]
+            distance = possible_phonetic_edit_distance(window, target_plain)
+            if distance > 1:
+                continue
+            first, last = selected[0], selected[-1]
+            begin, end = tokens[first]['index'], tokens[last]['index'] + 1
+            candidates.append({
+                'start': begin, 'end': end, 'text': text[begin:end],
+                'token_positions': [t['index'] for t in window],
+                'boundary_positions': [t['index'] for t in tokens[first:last + 1]
+                                       if t['kind'] == 'boundary'],
+                'oov_positions': [t['index'] for t in window if t['kind'] == 'oov'],
+                'ambiguous_reading_positions': [t['index'] for t in window
+                                                if len(t['readings']) > 1],
+                'minimum_possible_syllable_edits': distance,
+                'unknown_only': True, 'acoustic_tone_measured': False,
+            })
+    return candidates
+
