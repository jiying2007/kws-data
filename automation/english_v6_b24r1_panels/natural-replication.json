  "roster": [
    {
      "chapter": "271888",
      "source_id": "7078-271888-0064",
      "speaker": "7078",
      "transcript": "I RETURNED HOME FROM A STROLL ACROSS KENSINGTON GARDENS",
      "transcript_file_sha256": "972d36a106c161138e77a34286af7d3091c40be1ba63d6a49299c3503680ddb2",
      "transcript_member": "LibriSpeech/train-clean-100/7078/271888/7078-271888.trans.txt"
    },
    {
      "chapter": "271888",
      "source_id": "7078-271888-0087",
      "speaker": "7078",
      "transcript": "AND THAT IT WAS STANDING IN A CORNER WITH ITS FACE TO THE WALL",
      "transcript_file_sha256": "972d36a106c161138e77a34286af7d3091c40be1ba63d6a49299c3503680ddb2",
      "transcript_member": "LibriSpeech/train-clean-100/7078/271888/7078-271888.trans.txt"
    },
    {
      "chapter": "86737",
      "source_id": "7367-86737-0006",
      "speaker": "7367",
      "transcript": "BRAVO AN EXCELLENT IDEA WE WILL DISGUISE OURSELVES AS MONSTER PULCHINELLOS",
      "transcript_file_sha256": "1fc9aab34a40c712531a6b7e5a608f60e20d1e1f555214d31d8eae08f0c97167",
      "transcript_member": "LibriSpeech/train-clean-100/7367/86737/7367-86737.trans.txt"
    },
    {
      "chapter": "86737",
      "source_id": "7367-86737-0040",
      "speaker": "7367",
      "transcript": "FOR AT TERRACINA I WAS PLUNDERED EVEN OF MY HUNTING KNIFE",
      "transcript_file_sha256": "1fc9aab34a40c712531a6b7e5a608f60e20d1e1f555214d31d8eae08f0c97167",
      "transcript_member": "LibriSpeech/train-clean-100/7367/86737/7367-86737.trans.txt"
    },
    {
      "chapter": "294887",
      "source_id": "8468-294887-0025",
      "speaker": "8468",
      "transcript": "AND BY DIFFERENT AGENCIES TO CANADA TWO",
      "transcript_file_sha256": "616e77da08637a6d141715928d65de744805b95f7945a7352fedc7762082ec4a",
      "transcript_member": "LibriSpeech/train-clean-100/8468/294887/8468-294887.trans.txt"
    },
    {
      "chapter": "286673",
      "source_id": "8468-286673-0034",
      "speaker": "8468",
      "transcript": "AND AGAIN HE FELL FAST ASLEEP",
      "transcript_file_sha256": "7dabd82c4c40a7757e985e8ecd605c6cc769779d1a0bfbdd9cfecec4fab7d5ce",
      "transcript_member": "LibriSpeech/train-clean-100/8468/286673/8468-286673.trans.txt"
    },
    {
      "chapter": "152900",
      "source_id": "2384-152900-0031",
      "speaker": "2384",
      "transcript": "FIRST THE REINDEER SKINS HAD TO BE BOUGHT IN A RAW STATE",
      "transcript_file_sha256": "074c2717be3610f34eaefc53550349519dc78c26ab9727cc9fe67cb25d7057cb",
      "transcript_member": "LibriSpeech/train-clean-100/2384/152900/2384-152900.trans.txt"
    },
    {
      "chapter": "152900",
      "source_id": "2384-152900-0077",
      "speaker": "2384",
      "transcript": "AND SNOW GOGGLES FROM DOCTOR SCHANZ",
      "transcript_file_sha256": "074c2717be3610f34eaefc53550349519dc78c26ab9727cc9fe67cb25d7057cb",
      "transcript_member": "LibriSpeech/train-clean-100/2384/152900/2384-152900.trans.txt"
    },
    {
      "chapter": "121119",
      "source_id": "1034-121119-0000",
      "speaker": "1034",
      "transcript": "CHAPTER NINETY NINE THE LAW WE HAVE SEEN HOW QUIETLY",
      "transcript_file_sha256": "dde3667e4bd6a7940074d43d3f8fa7a0d9db83c4c00123660778689caa7198a6",
      "transcript_member": "LibriSpeech/train-clean-100/1034/121119/1034-121119.trans.txt"
    },
    {
      "chapter": "121119",
      "source_id": "1034-121119-0038",
      "speaker": "1034",
      "transcript": "HE SAW A LADY A FASHIONABLE ELEGANTLY DRESSED LADY",
      "transcript_file_sha256": "dde3667e4bd6a7940074d43d3f8fa7a0d9db83c4c00123660778689caa7198a6",
      "transcript_member": "LibriSpeech/train-clean-100/1034/121119/1034-121119.trans.txt"
    },
    {
      "chapter": "12359",
      "source_id": "2911-12359-0008",
      "speaker": "2911",
      "transcript": "SUCH NOTABLES AS SAINTE MAURE",
      "transcript_file_sha256": "e61f8b9131ed5d25a356ea6e2e969b9eedf64bbf5e7e1e4001a07e28ed867395",
      "transcript_member": "LibriSpeech/train-clean-100/2911/12359/2911-12359.trans.txt"
    },
    {
      "chapter": "12359",
      "source_id": "2911-12359-0013",
      "speaker": "2911",
      "transcript": "GRAPE CHEESE NAMED FROM THE NEUCHATEL WINE IN WHICH IT IS AGED",
      "transcript_file_sha256": "e61f8b9131ed5d25a356ea6e2e969b9eedf64bbf5e7e1e4001a07e28ed867395",
      "transcript_member": "LibriSpeech/train-clean-100/2911/12359/2911-12359.trans.txt"
    },
    {
      "chapter": "125237",
      "source_id": "1081-125237-0094",
      "speaker": "1081",
      "transcript": "ADDRESSED TO THE ESTATES OF HOLLAND NOT AT THE MOMENT IN SESSION",
      "transcript_file_sha256": "b994f075359ef273f363366848ee4823642e7b13081a18710aec8c616de1d6c2",
      "transcript_member": "LibriSpeech/train-clean-100/1081/125237/1081-125237.trans.txt"
    },
    {
      "chapter": "125237",
      "source_id": "1081-125237-0096",
      "speaker": "1081",
      "transcript": "AND THEN THE OFFICIAL LETTER FROM LONDON WAS READ TO THEM",
      "transcript_file_sha256": "b994f075359ef273f363366848ee4823642e7b13081a18710aec8c616de1d6c2",
      "transcript_member": "LibriSpeech/train-clean-100/1081/125237/1081-125237.trans.txt"
    },
    {
      "chapter": "172359",
      "source_id": "460-172359-0040",
      "speaker": "460",
      "transcript": "AND HE AND JOHNSON THE LIVERY STABLEKEEPER NEXT DOOR FORMED A SYNDICATE",
      "transcript_file_sha256": "e18d7db8252d6b97d7080d463a4a176cbe892d76f8dbc5f9029fb66dd080e370",
      "transcript_member": "LibriSpeech/train-clean-100/460/172359/460-172359.trans.txt"
    },
    {
      "chapter": "172359",
      "source_id": "460-172359-0090",
      "speaker": "460",
      "transcript": "A FELLER COULD GET ENOUGH OF THEM TO MAKE A SHOWING",
      "transcript_file_sha256": "e18d7db8252d6b97d7080d463a4a176cbe892d76f8dbc5f9029fb66dd080e370",
      "transcript_member": "LibriSpeech/train-clean-100/460/172359/460-172359.trans.txt"
    },
    {
      "chapter": "126290",
      "source_id": "458-126290-0002",
      "speaker": "458",
      "transcript": "SO THE POT WAS PLACED IN SAFETY",
      "transcript_file_sha256": "c951c98003c1da502a4707bebf7acb6d70bd81ab771eeb63530c6f26fceb806f",
      "transcript_member": "LibriSpeech/train-clean-100/458/126290/458-126290.trans.txt"
    },
    {
      "chapter": "126305",
      "source_id": "458-126305-0039",
      "speaker": "458",
      "transcript": "I SANK DEEP DEEP DOWN UNTIL AT LAST I GOT TO THE BOTTOM",
      "transcript_file_sha256": "50f6e5e7179405e818d675d2f3f01bed9de47ea80214d2a464d6bc9243235edc",
      "transcript_member": "LibriSpeech/train-clean-100/458/126305/458-126305.trans.txt"
    },
    {
      "chapter": "93314",
      "source_id": "696-93314-0064",
      "speaker": "696",
      "transcript": "HE'S VERY VERY CLEVER MY CHILD",
      "transcript_file_sha256": "19f3ff5048383dc1748cab330d668cfcb9dbc14363de735155eedcf3b5a377cd",
      "transcript_member": "LibriSpeech/train-clean-100/696/93314/696-93314.trans.txt"
    },
    {
      "chapter": "93314",
      "source_id": "696-93314-0016",
      "speaker": "696",
      "transcript": "OH HOW COULD YOU OF COURSE A REALLY HONOURABLE YOUNG MAN",
      "transcript_file_sha256": "19f3ff5048383dc1748cab330d668cfcb9dbc14363de735155eedcf3b5a377cd",
      "transcript_member": "LibriSpeech/train-clean-100/696/93314/696-93314.trans.txt"
    },
    {
      "chapter": "175658",
      "source_id": "3526-175658-0012",
      "speaker": "3526",
      "transcript": "THIS ROOM WAS CARPETED AND THEREIN WAS A PIANO A COUCH A CHIFFONNIERE",
      "transcript_file_sha256": "2ea6eba18f34ecce93b9de4dc05fd00a20569b721f9f3f7a879556164c5de71f",
      "transcript_member": "LibriSpeech/train-clean-100/3526/175658/3526-175658.trans.txt"
    },
    {
      "chapter": "176653",
      "source_id": "3526-176653-0051",
      "speaker": "3526",
      "transcript": "SAID THE LITTLE FELLOW PANTING IN SYMPATHY",
      "transcript_file_sha256": "ff7632163c92051d04b0b4d055853d22549c75ac7d6d27e65560d82ebf17dacb",
      "transcript_member": "LibriSpeech/train-clean-100/3526/176653/3526-176653.trans.txt"
    },
    {
      "chapter": "57195",
      "source_id": "5789-57195-0035",
      "speaker": "5789",
      "transcript": "IF ANYBODY TELLS YOU THAT IT'S ONLY JUST TO PUT YOU OFF",
      "transcript_file_sha256": "0e8da11fc8377c93404529406f4906f7b906e501d8871a791414a31f51567024",
      "transcript_member": "LibriSpeech/train-clean-100/5789/57195/5789-57195.trans.txt"
    },
    {
      "chapter": "70653",
      "source_id": "5789-70653-0013",
      "speaker": "5789",
      "transcript": "AND WHAT TIME IT WAS SHE HAD ASKED WHAT THE TIME WAS",
      "transcript_file_sha256": "9e89a7aeaa5db99818fbf2aa25fa95df8d974dc1780fdfdf076a4226b495c2fe",
      "transcript_member": "LibriSpeech/train-clean-100/5789/70653/5789-70653.trans.txt"
    }
