  "roster": [
    {
      "chapter": "16041",
      "source_id": "4680-16041-0004",
      "speaker": "4680",
      "transcript": "AND REACHED THE RUE DE RIVOLI THE SHOPS WERE OPEN THERE",
      "transcript_file_sha256": "547bcb775c3e437263256c891a5ddf4ecc282973b26cbac045a9595888546c7f",
      "transcript_member": "LibriSpeech/train-clean-100/4680/16041/4680-16041.trans.txt"
    },
    {
      "chapter": "16042",
      "source_id": "4680-16042-0004",
      "speaker": "4680",
      "transcript": "MARIUS HAD BUT A STEP MORE TO TAKE",
      "transcript_file_sha256": "3448f69ef7247abff288abbe6fbd497a00a4304dd1b04c1efbb4c2ac9f2d6031",
      "transcript_member": "LibriSpeech/train-clean-100/4680/16042/4680-16042.trans.txt"
    },
    {
      "chapter": "19402",
      "source_id": "3699-19402-0020",
      "speaker": "3699",
      "transcript": "LIKE A PIKE IT LOOKS WELL AT LEAST QUOTH MY FATHER TO HIMSELF",
      "transcript_file_sha256": "897b10b56464d17543aaa29af442367dd2cb99a4fea431b87a0e3bca3407b6e9",
      "transcript_member": "LibriSpeech/train-clean-100/3699/19402/3699-19402.trans.txt"
    },
    {
      "chapter": "175950",
      "source_id": "3699-175950-0000",
      "speaker": "3699",
      "transcript": "S'DEATH CRIED MY GREAT GRANDFATHER CLAPPING HIS HAND UPON HIS NOSE",
      "transcript_file_sha256": "662869bc9712cacc30366c33ed3a007e94ec2944f35517f210a8d20c1d6438a4",
      "transcript_member": "LibriSpeech/train-clean-100/3699/175950/3699-175950.trans.txt"
    },
    {
      "chapter": "48608",
      "source_id": "5808-48608-0027",
      "speaker": "5808",
      "transcript": "YES REPLIED SHE WHEREUPON THEY PRAYED TO ALLAH EXTOLLED AND EXALTED BE HE",
      "transcript_file_sha256": "f143bca786286724d931a2121eade61d4f54aea4e5bdcad4fb265d06d2d32ff4",
      "transcript_member": "LibriSpeech/train-clean-100/5808/48608/5808-48608.trans.txt"
    },
    {
      "chapter": "54425",
      "source_id": "5808-54425-0055",
      "speaker": "5808",
      "transcript": "THIS WAS A TERRIBLE TERRIBLE MAN OR A MONSTER",
      "transcript_file_sha256": "735aed9df68e43dd534b48dff6a2bfff72d8b0889a1f914542012ffc362b9371",
      "transcript_member": "LibriSpeech/train-clean-100/5808/54425/5808-54425.trans.txt"
    },
    {
      "chapter": "138263",
      "source_id": "1455-138263-0009",
      "speaker": "1455",
      "transcript": "INDEED SAID BARBICANE INDEED CONTINUED MICHEL IT IS ENOUGH TO SAY",
      "transcript_file_sha256": "d8aae1811397dbaa2513fa085146c5d4703d71e6c634e49b203a4aaa68cfcfbe",
      "transcript_member": "LibriSpeech/train-clean-100/1455/138263/1455-138263.trans.txt"
    },
    {
      "chapter": "134435",
      "source_id": "1455-134435-0058",
      "speaker": "1455",
      "transcript": "WHEN HE HAD FIRST COME OUT OF THE CITY TO LIVE ON THE LAND",
      "transcript_file_sha256": "99d41669f2189c2230bf90466a8b21af3720d7c597901633906270e2d14ab6c4",
      "transcript_member": "LibriSpeech/train-clean-100/1455/134435/1455-134435.trans.txt"
    },
    {
      "chapter": "34601",
      "source_id": "6209-34601-0009",
      "speaker": "6209",
      "transcript": "THE CHILD TURNED BACK",
      "transcript_file_sha256": "2fc8994ef856b8991e491182d99f2bfbced2b259455ca59c7b3f87b259128965",
      "transcript_member": "LibriSpeech/train-clean-100/6209/34601/6209-34601.trans.txt"
    },
    {
      "chapter": "34600",
      "source_id": "6209-34600-0027",
      "speaker": "6209",
      "transcript": "THE CHILD FELT THE COLDNESS OF MEN MORE TERRIBLY THAN THE COLDNESS OF NIGHT",
      "transcript_file_sha256": "636cacc8afce27f84147ccb20fa8d2df229713b7d6ed6950747421040c3c0efb",
      "transcript_member": "LibriSpeech/train-clean-100/6209/34600/6209-34600.trans.txt"
    },
    {
      "chapter": "138035",
      "source_id": "2989-138035-0014",
      "speaker": "2989",
      "transcript": "BOWLS OVER THE NINE PINS AS IF BY MAGIC",
      "transcript_file_sha256": "30ee3a4cd30ecdf16efd99980381e4be4aeeb7da843d388b0cb9c2fedb9cf8b9",
      "transcript_member": "LibriSpeech/train-clean-100/2989/138035/2989-138035.trans.txt"
    },
    {
      "chapter": "138028",
      "source_id": "2989-138028-0074",
      "speaker": "2989",
      "transcript": "WITH WHOM HE HAD PREVIOUSLY DISCUSSED THE SUBJECT",
      "transcript_file_sha256": "2e3e4a9b9525da88204f931957ae873c2e0cb92e496d2d2530bd7b9b5d4f6079",
      "transcript_member": "LibriSpeech/train-clean-100/2989/138028/2989-138028.trans.txt"
    },
    {
      "chapter": "27671",
      "source_id": "4853-27671-0027",
      "speaker": "4853",
      "transcript": "THE BOAT WAS ABOUT FIFTEEN FEET LONG",
      "transcript_file_sha256": "415e44616ad79b1bd4175786dd48de090455ae80ea1cb551ce87dfe10960641f",
      "transcript_member": "LibriSpeech/train-clean-100/4853/27671/4853-27671.trans.txt"
    },
    {
      "chapter": "29413",
      "source_id": "4853-29413-0032",
      "speaker": "4853",
      "transcript": "AND NOTHING MORE THAT YOU HAVE FORGOTTEN AND OUGHT TO TELL ME NOTHING SIR",
      "transcript_file_sha256": "212dce7488e56f78427d4f2e24ec022634892dde483be7ddbba41980c630ec8a",
      "transcript_member": "LibriSpeech/train-clean-100/4853/29413/4853-29413.trans.txt"
    },
    {
      "chapter": "36619",
      "source_id": "2764-36619-0038",
      "speaker": "2764",
      "transcript": "IN MASTER'S LITTLE APARTMENT CONSEIL ANSWERED IN MASTER'S MUSEUM",
      "transcript_file_sha256": "df428707bb30bae96048e51a684d4b38502b0b6ad722ec0bbf373d22844b1c3d",
      "transcript_member": "LibriSpeech/train-clean-100/2764/36619/2764-36619.trans.txt"
    },
    {
      "chapter": "36616",
      "source_id": "2764-36616-0009",
      "speaker": "2764",
      "transcript": "DESPITE THE ENDLESS WITTICISMS HEAPED ON IT BY THE POPULAR PRESS",
      "transcript_file_sha256": "472ff450231ed0c1c279acc42be1840c6d18dfae547e2d67538c80cdc4251308",
      "transcript_member": "LibriSpeech/train-clean-100/2764/36616/2764-36616.trans.txt"
    },
    {
      "chapter": "495",
      "source_id": "26-495-0018",
      "speaker": "26",
      "transcript": "SAINT BRIDE'S SIX SAINT JAMES'S NINE",
      "transcript_file_sha256": "f7a4e579d38e16a88dd844e802455083b90d8f83f88b8de8d00ec0007a8af437",
      "transcript_member": "LibriSpeech/train-clean-100/26/495/26-495.trans.txt"
    },
    {
      "chapter": "496",
      "source_id": "26-496-0006",
      "speaker": "26",
      "transcript": "AND OF THE LAST THE BILL ITSELF SAID",
      "transcript_file_sha256": "076edbdd4ffb18618f32f236297ee8547428690d7bfeafa3f2bc7c2b72d11bcb",
      "transcript_member": "LibriSpeech/train-clean-100/26/496/26-496.trans.txt"
    },
    {
      "chapter": "274562",
      "source_id": "7780-274562-0066",
      "speaker": "7780",
      "transcript": "THEREFORE HER SUSCEPTIBILITY OF IMPROVEMENT",
      "transcript_file_sha256": "18e8f21bfd0fe930c6453afb38e0696a444983e3fcdad7569c9e71e33a071d47",
      "transcript_member": "LibriSpeech/train-clean-100/7780/274562/7780-274562.trans.txt"
    },
    {
      "chapter": "274562",
      "source_id": "7780-274562-0035",
      "speaker": "7780",
      "transcript": "OR IN THE NATURE OF HIS INTELLECT",
      "transcript_file_sha256": "18e8f21bfd0fe930c6453afb38e0696a444983e3fcdad7569c9e71e33a071d47",
      "transcript_member": "LibriSpeech/train-clean-100/7780/274562/7780-274562.trans.txt"
    },
    {
      "chapter": "219",
      "source_id": "89-219-0010",
      "speaker": "89",
      "transcript": "AND HOW MIGHT YOU LEARN BY ACCIDENT OR ARGUMENT",
      "transcript_file_sha256": "0ff16a0ac837cf61176fe29ea979185e25ba76a4da888903f898b79da0242f79",
      "transcript_member": "LibriSpeech/train-clean-100/89/219/89-219.trans.txt"
    },
    {
      "chapter": "219",
      "source_id": "89-219-0031",
      "speaker": "89",
      "transcript": "NEITHER HER FATHER NOR MISTER ALLEN DID SO IT WAS CERTAINLY VERY PROVOKING",
      "transcript_file_sha256": "0ff16a0ac837cf61176fe29ea979185e25ba76a4da888903f898b79da0242f79",
      "transcript_member": "LibriSpeech/train-clean-100/89/219/89-219.trans.txt"
    },
    {
      "chapter": "11218",
      "source_id": "4051-11218-0046",
      "speaker": "4051",
      "transcript": "WHAT IS IT ASKED JASON HAVE YOU COME SO FAR TO SEEK IT",
      "transcript_file_sha256": "0aecb93f380f5d1e76d101875678101c617f63b4ed7f64282d9b2617129074b0",
      "transcript_member": "LibriSpeech/train-clean-100/4051/11218/4051-11218.trans.txt"
    },
    {
      "chapter": "11217",
      "source_id": "4051-11217-0027",
      "speaker": "4051",
      "transcript": "FOR BEAUTIFUL AS SHE NOW LOOKED",
      "transcript_file_sha256": "9490d28eb1f33c3cdb6af51d2d2916cf043247f930ed390664ec6cd98fadb521",
      "transcript_member": "LibriSpeech/train-clean-100/4051/11217/4051-11217.trans.txt"
    }
