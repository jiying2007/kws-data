  "roster": [
    {
      "chapter": "123720",
      "source_id": "481-123720-0028",
      "speaker": "481",
      "transcript": "SO THE THREE OF US WITH ZVERKOV FOR THE FOURTH",
      "transcript_file_sha256": "9a6f1b7189f05d80af8e58b95b451d3bf7e7a7f6477ac026fd3ee767f0c4ec7f",
      "transcript_member": "LibriSpeech/train-clean-100/481/123720/481-123720.trans.txt"
    },
    {
      "chapter": "123720",
      "source_id": "481-123720-0077",
      "speaker": "481",
      "transcript": "AND WORST OF ALL HOW PALTRY UNLITERARY COMMONPLACE IT WOULD ALL BE",
      "transcript_file_sha256": "9a6f1b7189f05d80af8e58b95b451d3bf7e7a7f6477ac026fd3ee767f0c4ec7f",
      "transcript_member": "LibriSpeech/train-clean-100/481/123720/481-123720.trans.txt"
    },
    {
      "chapter": "173565",
      "source_id": "3168-173565-0036",
      "speaker": "3168",
      "transcript": "BUT AN ENEMY CAN ONLY BE LOVED BY DIVINE LOVE",
      "transcript_file_sha256": "bf5b9589555b96ae3bf6ddbd7aa82561b4c3a18101672cb530f168d0ac5b6c98",
      "transcript_member": "LibriSpeech/train-clean-100/3168/173565/3168-173565.trans.txt"
    },
    {
      "chapter": "173565",
      "source_id": "3168-173565-0046",
      "speaker": "3168",
      "transcript": "HE MOVED A LITTLE AND SUDDENLY THERE WAS A RINGING IN HIS EARS",
      "transcript_file_sha256": "bf5b9589555b96ae3bf6ddbd7aa82561b4c3a18101672cb530f168d0ac5b6c98",
      "transcript_member": "LibriSpeech/train-clean-100/3168/173565/3168-173565.trans.txt"
    },
    {
      "chapter": "28461",
      "source_id": "4898-28461-0058",
      "speaker": "4898",
      "transcript": "I MARCHED HIM SLOWLY DOWN IN THE STARLIGHT ON THE COMPARATIVELY SMOOTH",
      "transcript_file_sha256": "0665cd7dd28229f44fe5a4d5d5599cb4191ff719fde4db526ac86b19bb8a602d",
      "transcript_member": "LibriSpeech/train-clean-100/4898/28461/4898-28461.trans.txt"
    },
    {
      "chapter": "28461",
      "source_id": "4898-28461-0056",
      "speaker": "4898",
      "transcript": "AND SUCCEEDED IN GETTING ONE OF HIS ARMS INTO PLACE",
      "transcript_file_sha256": "0665cd7dd28229f44fe5a4d5d5599cb4191ff719fde4db526ac86b19bb8a602d",
      "transcript_member": "LibriSpeech/train-clean-100/4898/28461/4898-28461.trans.txt"
    },
    {
      "chapter": "34645",
      "source_id": "7178-34645-0037",
      "speaker": "7178",
      "transcript": "BASED THE ROYAL DECISION THE LORD CHANCELLOR ADDED IN A POSTSCRIPT",
      "transcript_file_sha256": "1c111156176e74578385c17c13f7eee308a4ca346e6188253bedbbe1578daed8",
      "transcript_member": "LibriSpeech/train-clean-100/7178/34645/7178-34645.trans.txt"
    },
    {
      "chapter": "34644",
      "source_id": "7178-34644-0028",
      "speaker": "7178",
      "transcript": "JACQUES QUARTOURZE ALIAS LE NARBONNAIS LUC PIERRE CAPGAROUPE",
      "transcript_file_sha256": "0f7f79adba7bf5349699079098b5da8b909a2f4d25d5254d7897545a9bbd6626",
      "transcript_member": "LibriSpeech/train-clean-100/7178/34644/7178-34644.trans.txt"
    },
    {
      "chapter": "121652",
      "source_id": "289-121652-0010",
      "speaker": "289",
      "transcript": "AND LITTLE BOY BLUE IN SIXTEEN NINETY SEVEN CHARLES PERRAULT PUBLISHED IN FRANCE",
      "transcript_file_sha256": "2ed935f039e447d73fceea56f5f7616842c465f7d760f602760cae6651346016",
      "transcript_member": "LibriSpeech/train-clean-100/289/121652/289-121652.trans.txt"
    },
    {
      "chapter": "121652",
      "source_id": "289-121652-0038",
      "speaker": "289",
      "transcript": "L FRANK BAUM CHICAGO ILLINOIS",
      "transcript_file_sha256": "2ed935f039e447d73fceea56f5f7616842c465f7d760f602760cae6651346016",
      "transcript_member": "LibriSpeech/train-clean-100/289/121652/289-121652.trans.txt"
    },
    {
      "chapter": "130880",
      "source_id": "229-130880-0048",
      "speaker": "229",
      "transcript": "FOR ORIENTALS IT'S A DROP OF SOLIDIFIED DEW FOR THE LADIES IT'S A JEWEL",
      "transcript_file_sha256": "97f78b54c24f0441b5643dbaddf47f276cd737931469e57a98d212bbb85989d1",
      "transcript_member": "LibriSpeech/train-clean-100/229/130880/229-130880.trans.txt"
    },
    {
      "chapter": "130880",
      "source_id": "229-130880-0074",
      "speaker": "229",
      "transcript": "HAVEN'T CERTAIN FAMOUS PEARLS BEEN QUOTED AT EXTREMELY HIGH PRICES YES MY BOY",
      "transcript_file_sha256": "97f78b54c24f0441b5643dbaddf47f276cd737931469e57a98d212bbb85989d1",
      "transcript_member": "LibriSpeech/train-clean-100/229/130880/229-130880.trans.txt"
    },
    {
      "chapter": "122947",
      "source_id": "163-122947-0082",
      "speaker": "163",
      "transcript": "THESE ARE MEN WITHOUT DUTY WE HAVE ALWAYS FOOLS AND APPEARANCES AGAINST US",
      "transcript_file_sha256": "b1e0a4b52d462f7808df33a53689b637618dcac3fe066d181060cab0a69b3ed3",
      "transcript_member": "LibriSpeech/train-clean-100/163/122947/163-122947.trans.txt"
    },
    {
      "chapter": "122947",
      "source_id": "163-122947-0076",
      "speaker": "163",
      "transcript": "APPLIES TO THAT WHICH HAS TO BE FASHIONED BRUISED FORGED STRETCHED ROASTED ANNEALED REFINED",
      "transcript_file_sha256": "b1e0a4b52d462f7808df33a53689b637618dcac3fe066d181060cab0a69b3ed3",
      "transcript_member": "LibriSpeech/train-clean-100/163/122947/163-122947.trans.txt"
    },
    {
      "chapter": "139469",
      "source_id": "2002-139469-0069",
      "speaker": "2002",
      "transcript": "AND THE CAPE OF GOOD HOPE PLAGUE RAGED",
      "transcript_file_sha256": "f072e06b98214560a7355f4aeb0c600bd94bdb47e4d05d270fd85f919409d9e5",
      "transcript_member": "LibriSpeech/train-clean-100/2002/139469/2002-139469.trans.txt"
    },
    {
      "chapter": "139469",
      "source_id": "2002-139469-0068",
      "speaker": "2002",
      "transcript": "EVEN THE SOURCE OF COLONIES WAS DRIED UP FOR IN NEW HOLLAND",
      "transcript_file_sha256": "f072e06b98214560a7355f4aeb0c600bd94bdb47e4d05d270fd85f919409d9e5",
      "transcript_member": "LibriSpeech/train-clean-100/2002/139469/2002-139469.trans.txt"
    },
    {
      "chapter": "19215",
      "source_id": "5652-19215-0041",
      "speaker": "5652",
      "transcript": "HOMER WOULD CONSTRUCT THE ILIAD HE WOULD PUT IN HIS POEM",
      "transcript_file_sha256": "b4e75a864b20ba6f4321f0bf8ed36b5173d693208389d721056b08c4accff156",
      "transcript_member": "LibriSpeech/train-clean-100/5652/19215/5652-19215.trans.txt"
    },
    {
      "chapter": "19215",
      "source_id": "5652-19215-0032",
      "speaker": "5652",
      "transcript": "I PREDICT THAT ALL WAS LOST",
      "transcript_file_sha256": "b4e75a864b20ba6f4321f0bf8ed36b5173d693208389d721056b08c4accff156",
      "transcript_member": "LibriSpeech/train-clean-100/5652/19215/5652-19215.trans.txt"
    },
    {
      "chapter": "135589",
      "source_id": "1334-135589-0001",
      "speaker": "1334",
      "transcript": "YOU HAVE TO CHOOSE BETWEEN TWO GENERALS BOTH GREAT IN THE ART OF WAR",
      "transcript_file_sha256": "31d364c0025a251633d58648f7aedf8f2932567f42fe36c02f234bfad39725cf",
      "transcript_member": "LibriSpeech/train-clean-100/1334/135589/1334-135589.trans.txt"
    },
    {
      "chapter": "135589",
      "source_id": "1334-135589-0087",
      "speaker": "1334",
      "transcript": "AND IT MAY BE TRUE REPLIED EDWARD MOURNFULLY WELL",
      "transcript_file_sha256": "31d364c0025a251633d58648f7aedf8f2932567f42fe36c02f234bfad39725cf",
      "transcript_member": "LibriSpeech/train-clean-100/1334/135589/1334-135589.trans.txt"
    },
    {
      "chapter": "295463",
      "source_id": "8770-295463-0000",
      "speaker": "8770",
      "transcript": "CHAPTER NINETEEN THE GLORY OF GETTYSBURG THE BATTLE",
      "transcript_file_sha256": "807cb1a0831477f7de35dddd8dce2cd793090106a83fc052997541d64c882ccb",
      "transcript_member": "LibriSpeech/train-clean-100/8770/295463/8770-295463.trans.txt"
    },
    {
      "chapter": "295463",
      "source_id": "8770-295463-0024",
      "speaker": "8770",
      "transcript": "THERE WERE FIFTEEN THOUSAND PEOPLE WAITING",
      "transcript_file_sha256": "807cb1a0831477f7de35dddd8dce2cd793090106a83fc052997541d64c882ccb",
      "transcript_member": "LibriSpeech/train-clean-100/8770/295463/8770-295463.trans.txt"
    },
    {
      "chapter": "170379",
      "source_id": "2196-170379-0010",
      "speaker": "2196",
      "transcript": "BUT WORDS WHICH RING A BELL OR TAP THE EXPERIENTIAL BACKGROUND OF THE SUBJECT",
      "transcript_file_sha256": "7d6129e28d4d2cb4b9daaa656334883a9c167b8092a97fc93fcbb35efd4749d2",
      "transcript_member": "LibriSpeech/train-clean-100/2196/170379/2196-170379.trans.txt"
    },
    {
      "chapter": "170379",
      "source_id": "2196-170379-0034",
      "speaker": "2196",
      "transcript": "AND SO IN MY VIEW",
      "transcript_file_sha256": "7d6129e28d4d2cb4b9daaa656334883a9c167b8092a97fc93fcbb35efd4749d2",
      "transcript_member": "LibriSpeech/train-clean-100/2196/170379/2196-170379.trans.txt"
    }
