      "transcript_member": "LibriSpeech/train-clean-100/125/121124/125-121124.trans.txt"
    },
    {
      "chapter": "121342",
      "source_id": "125-121342-0024",
      "speaker": "125",
      "transcript": "I CAN'T IMAGINE NOT BEING ABLE TO",
      "transcript_file_sha256": "6911ca74b8eb6422d6191b85009a03f044f8f1b9ac1e290aab8bfa7ed32296aa",
      "transcript_member": "LibriSpeech/train-clean-100/125/121342/125-121342.trans.txt"
    },
