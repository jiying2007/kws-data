  "roster": [
    {
      "chapter": "5354",
      "source_id": "2836-5354-0041",
      "speaker": "2836",
      "transcript": "WHERE IS PIERRE MILADI ASKED",
      "transcript_file_sha256": "82f82f113a7efee39271d4f19daeced7a35ecfb766672042ca18af82f851d89c",
      "transcript_member": "LibriSpeech/train-clean-100/2836/5354/2836-5354.trans.txt"
    },
    {
      "chapter": "5354",
      "source_id": "2836-5354-0050",
      "speaker": "2836",
      "transcript": "SHE HAD HAD A LONG ILLNESS TERMINATING IN A LOW FEVER",
      "transcript_file_sha256": "82f82f113a7efee39271d4f19daeced7a35ecfb766672042ca18af82f851d89c",
      "transcript_member": "LibriSpeech/train-clean-100/2836/5354/2836-5354.trans.txt"
    },
    {
      "chapter": "5143",
      "source_id": "2136-5143-0041",
      "speaker": "2136",
      "transcript": "BUT CONTINUED HER TORTURE AND DISCORDANT LAUGHTER AT LAST SHE FINALLY RELEASED MY FINGER",
      "transcript_file_sha256": "6f2943b2345f2423cf60214bce3d69b0561d0741267d8f9e6f4b25367d1df6ce",
      "transcript_member": "LibriSpeech/train-clean-100/2136/5143/2136-5143.trans.txt"
    },
    {
      "chapter": "5143",
      "source_id": "2136-5143-0036",
      "speaker": "2136",
      "transcript": "WOULD NOT THAT BE PITY I REALLY DON'T KNOW ANYTHING OF HIS WILL",
      "transcript_file_sha256": "6f2943b2345f2423cf60214bce3d69b0561d0741267d8f9e6f4b25367d1df6ce",
      "transcript_member": "LibriSpeech/train-clean-100/2136/5143/2136-5143.trans.txt"
    },
    {
      "chapter": "158077",
      "source_id": "4088-158077-0016",
      "speaker": "4088",
      "transcript": "COMPARE THE METHODS WOMEN ADOPTED TO THOSE MEN USE IN THE PURSUIT OF DEMOCRACY",
      "transcript_file_sha256": "142e9b22957464dbec0bdac0c99632331403cca97c333159108782d3ea9a4557",
      "transcript_member": "LibriSpeech/train-clean-100/4088/158077/4088-158077.trans.txt"
    },
    {
      "chapter": "158077",
      "source_id": "4088-158077-0056",
      "speaker": "4088",
      "transcript": "AND DID NOT RELISH HAVING OUR QUESTION SO VIVID IN THE PUBLIC MIND",
      "transcript_file_sha256": "142e9b22957464dbec0bdac0c99632331403cca97c333159108782d3ea9a4557",
      "transcript_member": "LibriSpeech/train-clean-100/4088/158077/4088-158077.trans.txt"
    },
    {
      "chapter": "284756",
      "source_id": "8088-284756-0082",
      "speaker": "8088",
      "transcript": "I SMILED BACK AT HER AND SHOOK MY HEAD",
      "transcript_file_sha256": "312292b3138fd5377eaf3bb7a5052d2bdf19e37cbaebe8c4786f6d144263318b",
      "transcript_member": "LibriSpeech/train-clean-100/8088/284756/8088-284756.trans.txt"
    },
    {
      "chapter": "284756",
      "source_id": "8088-284756-0110",
      "speaker": "8088",
      "transcript": "THAT NO DOUBT WAS WHY SHE HATED HIM",
      "transcript_file_sha256": "312292b3138fd5377eaf3bb7a5052d2bdf19e37cbaebe8c4786f6d144263318b",
      "transcript_member": "LibriSpeech/train-clean-100/8088/284756/8088-284756.trans.txt"
    },
    {
      "chapter": "123291",
      "source_id": "887-123291-0026",
      "speaker": "887",
      "transcript": "HE COULD GET NO FURTHER",
      "transcript_file_sha256": "346ea07d1b5b23399a908e7779754098249ae0f578163b3ae9756cd57dc059ea",
      "transcript_member": "LibriSpeech/train-clean-100/887/123291/887-123291.trans.txt"
    },
    {
      "chapter": "123289",
      "source_id": "887-123289-0022",
      "speaker": "887",
      "transcript": "FOUR MONTHS CRIED THE PROFESSOR WE HAVE TIME TO GO AND TO RETURN",
      "transcript_file_sha256": "cc0e0b0f1b4d63f087488617630f63481549c9a878bffaf4df131c2dbff61bae",
      "transcript_member": "LibriSpeech/train-clean-100/887/123289/887-123289.trans.txt"
    },
    {
      "chapter": "54013",
      "source_id": "6078-54013-0026",
      "speaker": "6078",
      "transcript": "TO SEE WHAT HIS COMRADE WAS ABOUT",
      "transcript_file_sha256": "1f9c0420a2fc8719b9c9c78be936bd414ad3b9e5920f69ed90917d07db84b551",
      "transcript_member": "LibriSpeech/train-clean-100/6078/54013/6078-54013.trans.txt"
    },
    {
      "chapter": "54013",
      "source_id": "6078-54013-0008",
      "speaker": "6078",
      "transcript": "WHY THUS SAID THE SECOND",
      "transcript_file_sha256": "1f9c0420a2fc8719b9c9c78be936bd414ad3b9e5920f69ed90917d07db84b551",
      "transcript_member": "LibriSpeech/train-clean-100/6078/54013/6078-54013.trans.txt"
    },
    {
      "chapter": "100429",
      "source_id": "7517-100429-0032",
      "speaker": "7517",
      "transcript": "HAVE FALLEN IN THE LAST THREE WEEKS",
      "transcript_file_sha256": "18324fa5fc58327cacd3cd709a1c1695bb6d535c4ae0db87f7d9e29395a63658",
      "transcript_member": "LibriSpeech/train-clean-100/7517/100429/7517-100429.trans.txt"
    },
    {
      "chapter": "100437",
      "source_id": "7517-100437-0008",
      "speaker": "7517",
      "transcript": "WHO HAS NOT HEARD OF CLAUDE TILLIER",
      "transcript_file_sha256": "80137c587cfbe0af2451c5f603b0773e2a28b910abb6be39d4b145e738e0d4dc",
      "transcript_member": "LibriSpeech/train-clean-100/7517/100437/7517-100437.trans.txt"
    },
    {
      "chapter": "6379",
      "source_id": "1578-6379-0029",
      "speaker": "1578",
      "transcript": "HE TELEPHONED TO THE STATION BUT THEY DIDN'T KNOW ANYTHING ABOUT IT",
      "transcript_file_sha256": "61ba02576d879c9cb9187d7b34b5a37823645d9a31577d417dea72f82a18a92f",
      "transcript_member": "LibriSpeech/train-clean-100/1578/6379/1578-6379.trans.txt"
    },
    {
      "chapter": "6379",
      "source_id": "1578-6379-0013",
      "speaker": "1578",
      "transcript": "IS IT LOCKED YES PATTY NODDED BUT MY KEY WILL OPEN IT",
      "transcript_file_sha256": "61ba02576d879c9cb9187d7b34b5a37823645d9a31577d417dea72f82a18a92f",
      "transcript_member": "LibriSpeech/train-clean-100/1578/6379/1578-6379.trans.txt"
    },
    {
      "chapter": "80680",
      "source_id": "6925-80680-0063",
      "speaker": "6925",
      "transcript": "ONCE MORE THE BEAUTIFUL MAIDEN APPEARED AT HIS SUMMONS AND ASKED WHAT HE WANTED",
      "transcript_file_sha256": "0e8358c16cf3428e82cce64c4237221bd2e9a515db0fb52bda00a547a8ebbc6b",
      "transcript_member": "LibriSpeech/train-clean-100/6925/80680/6925-80680.trans.txt"
    },
    {
      "chapter": "80680",
      "source_id": "6925-80680-0036",
      "speaker": "6925",
      "transcript": "AMEER ALI THOUGHT THAT HER VOICE SOUNDED RATHER EAGER",
      "transcript_file_sha256": "0e8358c16cf3428e82cce64c4237221bd2e9a515db0fb52bda00a547a8ebbc6b",
      "transcript_member": "LibriSpeech/train-clean-100/6925/80680/6925-80680.trans.txt"
    },
    {
      "chapter": "127705",
      "source_id": "254-127705-0021",
      "speaker": "254",
      "transcript": "ON THE EVENING OF THE THIRD DAY AFTER STARTING OUT",
      "transcript_file_sha256": "ef5dd0a90be4c79a6ad2b1feca6948470eafbb11f56740ac52987ec1a41db701",
      "transcript_member": "LibriSpeech/train-clean-100/254/127705/254-127705.trans.txt"
    },
    {
      "chapter": "127705",
      "source_id": "254-127705-0006",
      "speaker": "254",
      "transcript": "MY YOUNG MEN BELIEVED THAT THE GOLD DIGGERS WERE OUR ENEMIES",
      "transcript_file_sha256": "ef5dd0a90be4c79a6ad2b1feca6948470eafbb11f56740ac52987ec1a41db701",
      "transcript_member": "LibriSpeech/train-clean-100/254/127705/254-127705.trans.txt"
    },
    {
      "chapter": "133709",
      "source_id": "1069-133709-0003",
      "speaker": "1069",
      "transcript": "SHE'D KEEP PEOPLE OFF VERY WELL I THINK",
      "transcript_file_sha256": "f5d842146358bd91e4374370e3631a1768d27e9dd3542cd8ccf9f044fff9ac35",
      "transcript_member": "LibriSpeech/train-clean-100/1069/133709/1069-133709.trans.txt"
    },
    {
      "chapter": "133699",
      "source_id": "1069-133699-0009",
      "speaker": "1069",
      "transcript": "AND SHE DETESTS ME FOR DETESTING IT",
      "transcript_file_sha256": "3aab8a817a40b6c399f1a3a0c21661fb0c9501519a1ebbbb640e05fb7e7178f1",
      "transcript_member": "LibriSpeech/train-clean-100/1069/133699/1069-133699.trans.txt"
    },
    {
      "chapter": "124146",
      "source_id": "322-124146-0022",
      "speaker": "322",
      "transcript": "SHE ADDED IN A MELANCHOLY TONE",
      "transcript_file_sha256": "28b6506e81da539cb37e8e26cc5f83fdacc487233d031ada8d2342fe1b007c43",
      "transcript_member": "LibriSpeech/train-clean-100/322/124146/322-124146.trans.txt"
    },
    {
      "chapter": "124147",
      "source_id": "322-124147-0075",
      "speaker": "322",
      "transcript": "SEEMED ALMOST AS FAR FROM POSSIBILITY",
      "transcript_file_sha256": "52c9c0e45ffd895d7ec50d89b6f70433aa6a4438c19261cdafb5bb7795e2f8b3",
      "transcript_member": "LibriSpeech/train-clean-100/322/124147/322-124147.trans.txt"
    }
